    "@near-js/transactions": "2.5.1",
    "@near-js/utils": "2.5.1",
    "@x402/near": "2.28.0",
    "better-sqlite3": "^12.0.0",
    "borsh": "1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0"
  }
